# URL base do fastrelax-api, incluindo o context-path /api/v1.
#
# Lida apenas no servidor: as chamadas saem do Next (Server Actions e Server
# Components), nunca do navegador. Por isso o token de acesso fica em cookie
# httpOnly e não chega ao bundle do cliente.
#
# Use o endereço que o *servidor do Next* alcança, não o que o usuário digita:
#   - API na mesma máquina  -> http://localhost:8090/api/v1
#   - API em outra máquina  -> http://10.48.0.189:8090/api/v1
FASTRELAX_API_URL=http://localhost:8090/api/v1

# Marca os cookies de sessão como `secure` (só trafegam em HTTPS).
#
# Servindo por IP na rede interna (http://10.48.0.189), o browser descarta
# cookie `secure` em silêncio: o login responde 200 e a próxima navegação
# volta para a tela de entrada. Ligue de novo assim que houver TLS.
SESSION_COOKIE_SECURE=false

# URL que o app Capacitor abre no WebView — este mesmo servidor Next.
CAPACITOR_SERVER_URL=http://10.48.0.189
